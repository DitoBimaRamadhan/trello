{
  "version": 2,
  "env": {
    "NODE_ENV": "production"
  },
  "buildCommand": "npm install && cd client && npm install && npm run build",
  "installCommand": "npm install",
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/server/index.js"
    },
    {
      "src": "/(.*)",
      "dest": "/client/dist/index.html"
    }
  ]
}
